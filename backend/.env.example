# Local development only. Copy to backend/.env and replace every placeholder.
APP_ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://tpro_backend:change-me@db-host:5432/postgres
# Keep total runtime connections below the shared pooler limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
# Remote databases require verify-full; use disable only for a trusted
# PostgreSQL instance on localhost. Supabase uses its project CA, mounted by
# docker-compose.supabase.example.yml at the path below.
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_ROOT_CERT=../certs/prod-ca-2021.crt
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
INTERNAL_TOKEN_ISSUER=tpro-classio-api
INTERNAL_TOKEN_AUDIENCE=tpro-classio-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_ABSOLUTE_EXPIRE_DAYS=30
EMAIL_OTP_EXPIRE_SECONDS=600
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
OWNER_ADMIN_EMAIL=owner@example.com

# Generate independently, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENCRYPTION_KEY=replace-with-an-independent-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
TOTP_ISSUER=TPRO English
INVITATION_EXPIRE_HOURS=24
ONBOARDING_SESSION_MINUTES=15
LOGIN_MFA_SESSION_MINUTES=5
AUTH_COOKIE_SECURE=false
AVATAR_STORAGE_BUCKET=avatars
AVATAR_MAX_BYTES=5242880
AVATAR_MAX_DIMENSION=512
AVATAR_SYNC_HOURS=12

# Early-payment preparation is provider-neutral and disabled by default. Set
# true locally only to expose the audited reference/QR-preparation action; it
# does not connect Pay2S or post payments automatically.
PAYMENT_PROVIDER=disabled
PAYMENT_QR_ENABLED=false
PAYMENT_QR_EXPIRE_HOURS=72
PAYMENT_EARLY_WINDOW_DAYS=62
PAYMENT_WEBHOOK_INGRESS_ENABLED=false
PAYMENT_AUTO_POST_ENABLED=false
PAY2S_API_BASE_URL=https://api-partner.pay2s.vn
PAY2S_COLLECTION_BASE_URL=https://payment.pay2s.vn
PAY2S_WEBHOOK_URL=https://api.example.com/webhooks/pay2s
PAY2S_REDIRECT_URL=https://app.example.com/fees
PAY2S_IPN_URL=https://api.example.com/webhooks/pay2s/ipn
PAY2S_HTTP_TIMEOUT_SECONDS=15
