* text=auto eol=lf

# Runtime/config files must retain Unix line endings when edited on Windows.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.sql text eol=lf
*.psql text eol=lf

# Binary assets.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.dump binary
*.backup binary
