# Docker Compose settings for local development.
# Secrets belong in backend/.env, never in this root file.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000

# Server-to-server URL inside the Compose network.
NEXT_INTERNAL_API_URL=http://backend:8000

# Canonical browser origin validated by the server-side BFF and cookie policy.
APP_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
